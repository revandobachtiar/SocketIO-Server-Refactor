{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "client-test/**/*.ts"
  ]
}